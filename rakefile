require "html-proofer"

`chcp 65001` if Gem.win_platform?

task :test do
  sh "bundle exec jekyll build --trace"
  HTMLProofer.check_directory(
    "./_site",
    allow_missing_href: true,
    disable_external: true,
    enforce_https: false,
    # Subtext-era posts, and the pagination pages that repeat them, have known dead links.
    ignore_files: [%r{\.aspx/}, %r{/page/\d+/}],
    # Protocol-relative script URLs in the templates are fine on an HTTPS-only site.
    ignore_urls: [%r{^//}]
  ).run
end
